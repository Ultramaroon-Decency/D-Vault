# =============================================
# SIH Backend - Environment Configuration
# Copy this to .env and fill in your values
# =============================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/sih_db?schema=public"

# ---- JWT ----
# Must be at least 32 characters of random entropy
JWT_SECRET=generate_a_random_32_char_hex_string_for_local_development
JWT_EXPIRES_IN=1h

# ---- Nonce TTL (seconds) ----
NONCE_TTL_SECONDS=300

# ---- Blockchain (Ethereum Sepolia) ----
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=11155111
BLOCKCHAIN_MOCK=true

# ---- Contract Addresses (set after blockchain team deploys) ----
DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
RBAC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NFT_ASSET_ADDRESS=0x0000000000000000000000000000000000000000

# ---- IPFS / Pinata ----
IPFS_MOCK=true
PINATA_JWT=your-pinata-jwt-token
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# REDIS_URL=redis://localhost:6379

# ---- Google OAuth & Whitelists ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@dvault.internal
MANAGER_EMAILS=manager@dvault.internal
