# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "false" to use real blockchain contracts instead of mock data
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── Network / Chain ───────────────────────────────────────────────────────────
# Chain ID: 11155111 = Sepolia, 80002 = Polygon Amoy, 31337 = Hardhat
NEXT_PUBLIC_CHAIN_ID=11155111

# ── Contract Addresses ────────────────────────────────────────────────────────
# Fill in once your blockchain teammate deploys contracts
NEXT_PUBLIC_DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RBAC_ADDRESS=0x0000000000000000000000000000000000000000

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo-project-id

# ── Backend API ───────────────────────────────────────────────────────────────
# Point to your backend teammate's API server
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── IMPORTANT: Never put private keys or secrets in NEXT_PUBLIC_ variables ────
# NEXT_PUBLIC_ variables are bundled into the browser. Keep secrets server-side.
